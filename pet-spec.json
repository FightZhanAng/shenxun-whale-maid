{
  "schemaVersion": 5,
  "app": {
    "name": "深寻鲸娘",
    "appId": "com.doubao.pet.whalemaid",
    "version": "1.0.0",
    "language": "zh-CN"
  },
  "targets": {
    "windows": {
      "enabled": true,
      "arch": "x64"
    },
    "macos": {
      "enabled": false,
      "arch": "current"
    }
  },
  "character": {
    "inputType": "text",
    "coreAsset": "core-ip/core-ip.png",
    "displayName": "鲸汐",
    "archetype": "fantasy",
    "personality": [
      "温柔",
      "有点迷糊",
      "爱干净",
      "声音软软的"
    ],
    "preserveTraits": [
      "二头身Q版比例，头大身小",
      "深海军蓝到浅青渐变的及腰长发与齐刘海",
      "两侧小小的鲸鱼鳍状蓝色耳鳍",
      "白色女仆发带与头顶一小簇白色水花",
      "深海蓝大眼睛、青色高光和淡粉腮红",
      "深蓝女仆裙、白色荷叶边围裙与青色蝴蝶结",
      "身后浅蓝色鲸尾，尾鳍在右后方微微翘起",
      "白色短袜与深蓝色圆头小皮鞋"
    ],
    "style": "balanced-cartoon",
    "mirrorSafe": false
  },
  "assetPipeline": {
    "backgroundMode": "semantic-cutout",
    "segmentationBackend": "auto",
    "subjectKind": "illustration",
    "generationBackground": "transparent-grid",
    "backgroundTolerance": 28,
    "edgeFeather": 12,
    "safeMargin": 24,
    "targetOccupancy": 0.78
  },
  "experience": {
    "theme": {
      "primary": "#2F5FD0",
      "accent": "#43C8DB",
      "background": "#EDF5FF",
      "surface": "#FFFFFF",
      "text": "#12213D",
      "muted": "#6C82A8",
      "cornerRadius": 24
    },
    "petSizing": {
      "baseWindowPx": 220,
      "defaultScale": 0.8
    },
    "interactions": [
      {
        "id": "pat-head",
        "label": "摸摸头",
        "stateId": "pet",
        "durationMs": 1300,
        "affectionGain": 3,
        "feedback": [
          "唔…好舒服",
          "再摸一下下嘛",
          "鲸汐的鳍鳍都在晃"
        ]
      },
      {
        "id": "feed-fish",
        "label": "喂小鱼干",
        "stateId": "feed",
        "durationMs": 1400,
        "affectionGain": 5,
        "feedback": [
          "是小鱼干！",
          "谢谢主人～",
          "深海的鱼最香了"
        ]
      },
      {
        "id": "dress-curtsy",
        "label": "提裙行礼",
        "stateId": "curtsy",
        "durationMs": 1350,
        "affectionGain": 4,
        "feedback": [
          "女仆鲸汐，为您服务",
          "主人今天也辛苦啦",
          "围裙有好好整理哦"
        ]
      },
      {
        "id": "spray-water",
        "label": "喷个小水花",
        "stateId": "spray",
        "durationMs": 1450,
        "affectionGain": 2,
        "feedback": [
          "尾巴一甩，水花就来啦",
          "小心别被淋到哦",
          "鲸汐的尾鳍最会喷水"
        ]
      },
      {
        "id": "fetch-shell",
        "label": "捡颗贝壳",
        "stateId": "fetch",
        "durationMs": 1450,
        "affectionGain": 3,
        "feedback": [
          "看！这颗贝壳是青色的",
          "深海里的贝壳最漂亮",
          "送给主人，收好哦"
        ]
      },
      {
        "id": "focus-session",
        "label": "陪你坐一会",
        "stateId": "focus",
        "durationMs": 5200,
        "affectionGain": 2,
        "feedback": [
          "我坐这里，安静陪着你",
          "翻书的声音很轻吧",
          "专注的时候，鲸汐守着"
        ]
      }
    ]
  },
  "motion": {
    "breathing": {
      "enabled": true,
      "periodMs": 3400,
      "scaleX": 0.012,
      "scaleY": 0.022
    },
    "squashStretch": {
      "enabled": true,
      "durationMs": 320,
      "intensity": 0.08
    },
    "idleIntervalMs": {
      "min": 7000,
      "max": 13000
    }
  },
  "features": {
    "transparentWindow": true,
    "drag": true,
    "tray": true,
    "edgeSnap": true,
    "reminders": true,
    "interactions": true,
    "relationship": true,
    "filePocket": false,
    "dashboard": true,
    "typingReaction": false,
    "autonomousMovement": false
